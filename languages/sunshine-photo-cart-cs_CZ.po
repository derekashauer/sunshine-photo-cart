msgstr "Zastavit úklid"

#: admin/tools.php:806 admin/tools.php:899
msgid "skipped"
msgstr "přeskočeno"

#: admin/tools.php:838
msgid "skipped (cloud copy not reachable)"
msgstr "přeskočeno (kopie v cloudu není dostupná)"

#: admin/tools.php:861
msgid "Stop the cleanup? Files already deleted will not be restored."
msgstr "Zastavit úklid? Již smazané soubory se neobnoví."

#: admin/tools.php:915
